    .diag-mesh {
      background-image:
        linear-gradient(135deg, rgba(245, 158, 11, 0.045) 1px, transparent 1px),
        linear-gradient(45deg, rgba(99, 102, 241, 0.045) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    .amber-glow {
      box-shadow: 0 12px 34px -6px rgba(245, 158, 11, 0.36), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    }
    .indigo-glow {
      box-shadow: 0 12px 32px -8px rgba(99, 102, 241, 0.38);
    }
    .phone-tilt {
      transform: perspective(1200px) rotateY(-10deg) rotateX(4deg);
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .phone-tilt:hover {
      transform: perspective(1200px) rotateY(-3deg) rotateX(1deg) translateY(-4px);
    }
    @media (max-width: 1023px) {
      .phone-tilt { transform: none; }
      .phone-tilt:hover { transform: translateY(-3px); }
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-7px); }
    }
    .float-slow { animation: floatSlow 4.5s ease-in-out infinite; }
    .float-slow-delayed { animation: floatSlow 5.2s ease-in-out 1.4s infinite; }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0E1018; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #272A3E; border-radius: 999px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: #F59E0B; }
